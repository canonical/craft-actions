{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["charmcraft/setup/**/*.ts", "common/**/*.ts", "rockcraft/pack/**/*.ts", "rockcraft/setup/**/*.ts", "snapcraft/setup/**/*.ts"],
  "exclude": ["**/dist/**"]
}
