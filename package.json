{
  "name": "craft-actions",
  "version": "0.0.1",
  "description": "A set of GitHub actions for using craft tools (like Snapcraft and Rockcraft)",
  "private": true,
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r run test",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint .; ESLINT=$?; tsc --noEmit; TSC=$?; exit $((ESLINT | TSC))",
    "lint-fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canonical/craft-actions.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/canonical/craft-actions/issues"
  },
  "homepage": "https://github.com/canonical/craft-actions#readme",
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
